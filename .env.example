# Portainer - Environment Variables
# Copy this file to .env and adjust values as needed:
#   cp .env.example .env

# Host port for Portainer Edge Agent (container 8000)
# 8001 is used to avoid conflict with common 8000 usage
EDGE_PORT=8001

# Host port for Portainer HTTP UI (container 9000)
HTTP_PORT=9000

# Host port for Portainer HTTPS UI (container 9443)
HTTPS_PORT=9443

# External network for HTTPS / reverse proxy (must exist: `docker network create https_network`)
# Example: https_network (see `docker network ls`)
HTTPS_NETWORK=https_network

# Plaintext admin password - only used on first initialization (when /data is empty)
# Portainer image is distroless (no shell), so a helper init container writes this
# value to a file and Portainer is started with --admin-password-file.
# Changing this after first init does NOT change the password - reset via UI or wipe portainer_data volume.
ADMIN_PASSWORD=changeme123
